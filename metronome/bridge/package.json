{
  "name": "shiftpay-bridge",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "abi": "node scripts/sync-abi.mjs",
    "keys:prepare": "node scripts/prepare-service-keys.mjs",
    "db:up": "docker compose up -d postgres",
    "db:push": "prisma db push --skip-generate",
    "generate": "prisma generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:testnet": "vitest run --config vitest.testnet.config.ts",
    "demo:clock": "tsx scripts/demo-clock.ts",
    "reconcile": "tsx scripts/reconcile.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "benchmark:prepare": "tsx scripts/prepare-benchmark.ts",
    "deployment:check": "tsx scripts/deployment-check.ts",
    "demo:local": "tsx scripts/local-demo.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "dotenv": "^16.6.1",
    "fastify": "^5.12.5",
    "viem": "^2.57.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
