# Copy to .env and configure actual service settings. keys:prepare creates local
# service-only keys in .env.runtime-keys; it never accesses your MetaMask keys.

# Postgres (docker compose up -d postgres)
DATABASE_URL=postgresql://metronome:metronome@localhost:5433/metronome?schema=public

# Monad Testnet (official values; explorer: https://testnet.monadexplorer.com/)
MONAD_RPC_URL=https://testnet-rpc.monad.xyz/
MONAD_CHAIN_ID=10143

# Deployed MetronomeVault and your employer id (from contracts/script/Deploy.s.sol output)
VAULT_ADDRESS=
VAULT_DEPLOY_BLOCK=
EMPLOYER_ID=

# EIP-712 signer registered as the employer's attestor on the vault
ATTESTOR_PRIVATE_KEY=
# Comma-separated relayer keys funded with testnet MON. Shard s is submitted by key s % N.
RELAYER_PRIVATE_KEYS=

# Shared secrets, at least 32 characters each
WEBHOOK_SECRET=
ADMIN_API_TOKEN=

PORT=8787
ATTESTATION_TTL_SECONDS=600
CONFIRMATIONS=1

# Existing RPC indexing stays selected until Envio credentials are configured.
# Select envio to power the workforce and payment ledger with real HyperSync events.
# Configured Envio failures stop indexing; there is no automatic RPC substitution.
PAYROLL_EVENT_SOURCE=rpc
# Set ENVIO_API_TOKEN locally when selecting envio; never put it in frontend variables.
